# Safe fresh-clone default: offline simulation with no credentials or network.
LLM_PROVIDER=mock
GEMINI_MODEL=gemini-2.5-flash

# Optional persistent data location. Defaults to <repo-root>/database.
# SYNTHESIS_DB_DIR=<absolute-path-to-synthesis-data>

# For a real work-laptop Vertex deployment, copy .env.vertexai.example instead.
# For a personal API-key deployment, copy .env.api-key.example instead.
