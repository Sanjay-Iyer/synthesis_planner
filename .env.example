# Copy this file to ".env" and fill in the values for THIS machine.
# .env is git-ignored, so each laptop keeps its own settings. Pick ONE auth
# mode below — the app auto-detects which one is configured.

# ---------------------------------------------------------------------------
# Auth mode A — API key (Google AI Studio).  Simplest; good for a personal box.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Auth mode B — Vertex AI via gcloud (no API key; good for a locked-down/work
# laptop).  First authenticate once on the machine:
#     gcloud auth application-default login
# then set these (and leave GEMINI_API_KEY unset):
# ---------------------------------------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Optional — default model when the UI dropdown doesn't specify one.
# (The selectable list lives in data/gemini_models.json.)
# ---------------------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Optional — relocate the SQLite DB + data files off the repo folder. Useful
# if the repo lives somewhere read-only on a restricted machine. Defaults to
# <project_root>/database. Use this machine's own absolute path.
# ---------------------------------------------------------------------------
# SYNTHESIS_DB_DIR=C:\Users\you\synthesis_data
